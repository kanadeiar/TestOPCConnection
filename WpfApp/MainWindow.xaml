<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="Опытное соединение с OPC-сервером" Height="355" Width="673">
    <Grid>
        <Label Content="Метраж:&#xD;&#xA;" HorizontalAlignment="Left" Margin="25,25,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.035,-0.049" Height="28"/>
        <Label Content="Скорость:" HorizontalAlignment="Left" Margin="25,58,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TextBoxMetrazh" HorizontalAlignment="Left" Margin="116,30,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="TextBoxSpeed" HorizontalAlignment="Left" Margin="116,62,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="ButtonUpdate" Content="Button" HorizontalAlignment="Left" Margin="116,93,0,0" VerticalAlignment="Top" Width="117" Height="31" Click="ButtonUpdate_Click"/>

    </Grid>
</Window>
